<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- account.move -->
        <record id="is_view_move_form" model="ir.ui.view">
            <field name="name">is_view_move_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- v20 : une seule ligne « échéance ou conditions de paiement » ; comme en v15, les deux sur des lignes séparées -->
                <xpath expr="//label[@for='invoice_date_due']/.." position="replace"/>
                <xpath expr="//div[@name='due_date']" position="replace">
                    <field name="invoice_payment_term_id"
                           context="{'example_date': invoice_date, 'example_amount': tax_totals['total_amount_currency']}"
                           options="{'no_quick_create':True}" readonly="state in ['cancel', 'posted']"
                           invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"/>
                    <field name="invoice_date_due" force_save="1"
                           invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt')"
                           decoration-danger="invoice_date_due and invoice_date_due &lt; context_today().strftime('%Y-%m-%d') and payment_state not in ('paid', 'in_payment', 'reversed')"/>
                </xpath>
            </field>
        </record>
        <record id="is_view_out_invoice_tree" model="ir.ui.view">
            <field name="name">is_view_out_invoice_tree</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <field name="invoice_date_due" position="before">
                    <field name="invoice_payment_term_id" optional="show"/>
                </field>
            </field>
        </record>


        <!-- account.account -->
       <record id="is_account_account_action" model="ir.actions.act_window">
            <field name="name">Plan comptable</field>
            <field name="res_model">account.account</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>
        <menuitem
            id="is_account_account_menu" 
            action="is_account_account_action"  
            parent="account.account_account_menu" sequence="900"
        />

    </data>
</odoo>
