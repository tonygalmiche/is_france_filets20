<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Migration v20 : la page de la facture v15 (remplacée en entier) est abandonnée au profit de la facture
             standard (mentions obligatoires françaises de l10n_fr_account, Factur-X, QR code), complétée ici -->
        <template id="is_report_invoice_document" inherit_id="account.report_invoice_document">
            <xpath expr="//div[@id='informations']" position="inside">
                <t t-set="orders" t-value="o.invoice_line_ids.sale_line_ids.order_id"/>
                <t t-set="chantier" t-value="orders[-1:].is_nom_chantier"/>
                <t t-set="ref_client" t-value="orders[-1:].is_ref_client"/>
                <div class="col" t-if="o.partner_id.is_code_client_ebp" name="is_code_client_ebp">
                    <strong>Code Client</strong>
                    <div t-field="o.partner_id.is_code_client_ebp"/>
                </div>
                <div class="col" t-if="o.invoice_payment_term_id" name="is_payment_term">
                    <strong>Mode de règlement</strong>
                    <div t-field="o.invoice_payment_term_id"/>
                </div>
                <div class="col" t-if="chantier" name="is_chantier">
                    <strong>Chantier</strong>
                    <div t-out="chantier"/>
                </div>
                <div class="col" t-if="ref_client" name="is_ref_client">
                    <strong>Votre référence</strong>
                    <div t-out="ref_client"/>
                </div>
            </xpath>

            <xpath expr="//div[@id='payment_term']" position="inside">
                <div t-if="o.partner_id.is_afacturage == 'Oui'" style="font-size:8pt;color:red" t-field="o.company_id.is_affacturage"/>
                <p t-field="o.company_id.is_conditions_generales"/>
            </xpath>
        </template>
    </data>
</odoo>
